{
  "name": "n8n-nodes-persona",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Persona identity verification platform providing 22 resources and 200+ operations for KYC/AML verification, document verification, biometric checks, watchlist screening, and compliance automation.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-persona.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-persona#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-persona/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "persona",
    "identity-verification",
    "kyc",
    "aml",
    "document-verification",
    "biometric",
    "liveness-detection",
    "watchlist-screening",
    "compliance",
    "fraud-prevention",
    "selfie-verification",
    "government-id",
    "pep-screening",
    "sanctions-screening",
    "background-check"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "LICENSING_FAQ.md",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PersonaApi.credentials.js",
      "dist/credentials/PersonaEmbedded.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Persona/Persona.node.js",
      "dist/nodes/Persona/PersonaTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && npm run copy-icons",
    "copy-icons": "cp -r nodes/Persona/*.svg dist/nodes/Persona/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.20.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
